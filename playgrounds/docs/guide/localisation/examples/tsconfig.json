{
  "extends": "../../../../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "../../../../..",
    "paths": {
      "@verific/core": ["../../../../../packages/core/src/main.ts"],
      "@verific/i18n": ["../../../../../packages/i18n/src/main.ts"],
      "@verific/i18n/i18next": ["../../../../../packages/i18n/src/i18next.ts"],
      "@verific/i18n/paraglide": ["../../../../../packages/i18n/src/paraglide.ts"],
      "@verific/i18n/vue-i18n": ["../../../../../packages/i18n/src/vue-i18n.ts"],
      "~/*": ["./*"]
    },
    "allowJs": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "./*.ts",
    "./paraglide/**/*.d.ts"
  ]
}
