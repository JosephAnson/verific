{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    ".vitepress/examples/**/*.vue",
    ".vitepress/examples/**/*.ts",
    "guide/examples/**/*.vue",
    "guide/examples/**/*.ts"
  ]
}
