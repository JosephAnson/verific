{
  "name": "verific",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Vue Validation Library",
  "author": "Joseph Anson <https://github.com/josephanson>",
  "license": "MIT",
  "homepage": "https://josephanson.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosephAnson/verific.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "setup": "pnpm build && pnpm --dir playgrounds/nuxt exec nuxt prepare",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter @verific/nuxt test:integration",
    "audit": "pnpm audit --audit-level high",
    "dependencies:check": "pnpm outdated -r --format json && pnpm audit",
    "packages:typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "typecheck": "pnpm build && pnpm packages:typecheck && pnpm --dir playgrounds/vue type-check && pnpm --dir playgrounds/nuxt exec nuxi typecheck",
    "dev": "cd ./playgrounds/nuxt && pnpm dev",
    "dev:docs": "cd ./playgrounds/docs && pnpm dev",
    "dev:nuxt": "cd ./playgrounds/nuxt && pnpm dev",
    "dev:vue": "cd ./playgrounds/vue && pnpm dev",
    "docs:build": "pnpm --dir playgrounds/docs build",
    "docs:check": "pnpm --dir playgrounds/docs check",
    "playgrounds:build": "pnpm --dir playgrounds/vue build && pnpm --dir playgrounds/nuxt build",
    "check": "pnpm dependencies:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm playgrounds:build && pnpm docs:check && pnpm test:integration",
    "release": "bumpp package.json packages/core/package.json packages/i18n/package.json packages/i18next/package.json packages/paraglide/package.json packages/vue-i18n/package.json packages/nuxt/package.json",
    "release:check": "node scripts/check-release-version.mjs",
    "publish:ci": "pnpm release:check --publish && pnpm check && pnpm -r --filter \"./packages/**\" publish --access public --no-git-checks"
  },
  "peerDependencies": {
    "vue": "^3.4.26"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.3",
    "@verific/core": "workspace:*",
    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "12.2.2",
    "changelogithub": "15.0.5",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "vitest run related --passWithNoTests"
    ]
  }
}
