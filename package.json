{
  "name": "verific",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.1",
  "description": "Vue Validation Library",
  "author": "Joseph Anson <https://github.com/josephanson>",
  "license": "MIT",
  "homepage": "https://josephanson.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephanson/verific.git"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "lint": "eslint . '**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint . '**/*.{js,jsx,ts,tsx}' --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm tsc --noEmit --project ./tsconfig.json --skipLibCheck",
    "dev": "cd ./playgrounds/nuxt && pnpm dev",
    "dev:docs": "cd ./playgrounds/docs && pnpm dev",
    "dev:nuxt": "cd ./playgrounds/nuxt && pnpm dev",
    "dev:vue": "cd ./playgrounds/vue && pnpm dev",
    "release": "bumpp"
  },
  "peerDependencies": {
    "vue": "^3.4.26"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.7.0",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/node": "^22.13.9",
    "@verific/core": "workspace:*",
    "@vitest/coverage-v8": "^3.0.8",
    "@vue/devtools-api": "^7.7.2",
    "bumpp": "^10.0.3",
    "eslint": "^9.21.0",
    "esno": "^4.8.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "raf-stub": "^3.0.0",
    "rollup": "^4.34.9",
    "rollup-plugin-dts": "^6.1.1",
    "type-fest": "^4.37.0",
    "typescript": "5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8",
    "vue": "^3.5.13"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "vitest run related --passWithNoTests"
    ]
  }
}
