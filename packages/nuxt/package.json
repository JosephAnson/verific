{
  "name": "@verific/nuxt",
  "type": "module",
  "version": "0.2.0",
  "description": "Vue Validation Library",
  "author": {
    "name": "Joseph Anson",
    "url": "https://github.com/josephanson"
  },
  "license": "MIT",
  "homepage": "https://verific.josephanson.com/",
  "repository": {
    "url": "git+https://github.com/JosephAnson/verific.git",
    "type": "git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/josephanson/verific/issues"
  },
  "keywords": [
    "VueJS",
    "Vue",
    "Nuxt",
    "NuxtJS",
    "validation",
    "validator",
    "inputs",
    "form"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build --stub && nuxt-module-build --watch",
    "test": "vitest run tests",
    "test:integration": "node tests/packed-consumer.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json --skipLibCheck",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nuxtjs/i18n": ">=10.6 <11",
    "@verific/core": "workspace:^",
    "@verific/vue-i18n": "workspace:^",
    "nuxt": ">=3.21 <5",
    "vue": "^3.4.26",
    "vue-i18n": ">=11.1 <12"
  },
  "peerDependenciesMeta": {
    "@nuxtjs/i18n": {
      "optional": true
    },
    "@verific/vue-i18n": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@verific/core": "workspace:*",
    "@verific/vue-i18n": "workspace:*",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "vue-i18n": "11.4.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
