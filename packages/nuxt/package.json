{
  "name": "@verific/nuxt",
  "type": "module",
  "version": "0.0.2",
  "description": "Vue Validation Library",
  "author": "Joseph Anson <https://github.com/antf>",
  "license": "MIT",
  "homepage": "https://verific.josephanson.com/",
  "repository": {
    "url": "git+https://github.com/josephanson/verific.git",
    "type": "git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/josephanson/verific/issues"
  },
  "keywords": [
    "VueJS",
    "Vue",
    "Nuxt",
    "NuxtJS",
    "validation",
    "validator",
    "inputs",
    "form"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build",
    "dev": "nuxt-module-build --stub && nuxt-module-build --watch",
    "test": "vitest",
    "release": "npx changelogen@latest --release",
    "publish": "pnpm publish"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0",
    "vue": "^3.4.26"
  },
  "dependencies": {
    "@nuxt/kit": "^3.10.3",
    "@verific/core": "workspace:*",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^0.5.5",
    "@nuxt/schema": "^3.10.3",
    "nuxt": "^3.10.3",
    "tsup": "^8.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
