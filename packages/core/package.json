{
  "name": "@verific/core",
  "type": "commonjs",
  "version": "0.2.0",
  "description": "Vue Validation Library",
  "author": {
    "name": "Joseph Anson",
    "url": "https://github.com/josephanson"
  },
  "license": "MIT",
  "homepage": "https://verific.josephanson.com/",
  "repository": {
    "url": "git+https://github.com/JosephAnson/verific.git",
    "type": "git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/josephanson/verific/issues"
  },
  "keywords": [
    "VueJS",
    "Vue",
    "validation",
    "validator",
    "inputs",
    "form"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    }
  },
  "main": "./dist/main.js",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/main.ts --format cjs,esm --dts --clean",
    "dev": "npm run build -- --watch",
    "test": "vitest run --root ../.. packages/core/tests",
    "typecheck": "tsc --noEmit -p tsconfig.json --skipLibCheck",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.4.26"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vue": "^3.5.42"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
